# ---- C5 WiFi Bridge 默认配置 ----

# 主频拉满, 保证 UART 高波特率 + 网络吞吐
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# UART ISR 放入 IRAM, 高波特率下避免丢字节 (与 S3 侧 ML307 同样的做法)
CONFIG_UART_ISR_IN_IRAM=y

# 5GHz 支持在 IDF 5.5 里由芯片能力位 CONFIG_SOC_WIFI_SUPPORT_5G 自动给出 (C5=y),
# 没有 CONFIG_ESP_WIFI_ENABLE_DUAL_BAND 这个选项。运行时频段模式改用
# esp_wifi_set_band_mode(WIFI_BAND_MODE_AUTO) 设置, 见 main/bridge_wifi.cc。

# mbedTLS: 允许 TLS 客户端, 用于 wss:// / mqtts:// / https://
CONFIG_MBEDTLS_SSL_PROTO_TLS1_3=y
CONFIG_MBEDTLS_CLIENT_SSL_SESSION_TICKETS=y

# 增大 socket 数量上限, 与 BRIDGE_MAX_LINKS 匹配留余量
CONFIG_LWIP_MAX_SOCKETS=10

# 日志等级
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# 任务看门狗放宽 (网络阻塞时不误杀)
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10

# 使用自定义分区表 (加大 app 分区以容纳 WiFi/TLS/配网)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# flash 大小 4MB
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"


# 控制台日志走 UART0 (配合板载 USB-UART 桥, COM20 可见)
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
